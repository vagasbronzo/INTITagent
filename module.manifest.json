{
  "id": "intit-agent",
  "name": "YEAH! Business",
  "repo": "vagasbronzo/INTITagent",
  "type": "vertical-module",
  "owner": "YEAH! OS",
  "status": "contract-implemented",
  "version": "0.2.0",
  "deployment": {
    "mode": "on-prem-compatible",
    "basePathEnv": "YEAH_BUSINESS_BASE_PATH",
    "runtimeBaseUrlEnv": "YEAH_BUSINESS_BASE_URL",
    "networkCoordinates": "runtime-secret-config-only"
  },
  "entrypoints": {
    "health": "/api/health",
    "capabilities": "/api/capabilities"
  },
  "capabilities": [
    "faq",
    "ticketing",
    "document-repository",
    "business-cube-readonly",
    "business-one-readonly",
    "invoice-reconciliation",
    "on-prem-deploy"
  ],
  "data_policy": {
    "stores_sensitive_data": false,
    "default_access": "read-only",
    "tenant_isolation": true,
    "requires_audit_log": true,
    "write_actions_require_explicit_approval": true,
    "internal_network_coordinates_in_repo": false
  },
  "security": {
    "moduleTokenEnv": "YEAH_BUSINESS_MODULE_TOKEN",
    "callerRole": "control-plane",
    "publicDataOperations": false,
    "failClosed": true
  },
  "environment": [
    "YEAH_BUSINESS_MODULE_TOKEN",
    "YEAH_BUSINESS_BASE_PATH",
    "BUSINESS_CUBE_READONLY_DSN",
    "BUSINESS_ONE_READONLY_DSN",
    "DOCUMENT_SHARE_PATH"
  ]
}
